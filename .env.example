# ─── Formulaire de contact ───────────────────────────────────────────────────
#
# RESEND_API_KEY  : votre clé API Resend (https://resend.com → API Keys)
# CONTACT_EMAIL   : adresse email qui reçoit les messages du formulaire
# RESEND_FROM     : adresse d'expéditeur vérifiée sur Resend
#                   → En test : "ELAYA <onboarding@resend.dev>"
#                   → En production : "ELAYA <noreply@votredomaine.com>"
#                     (nécessite un domaine vérifié dans Resend)
#
# Ces variables doivent être ajoutées dans Vercel :
#   Dashboard → Project → Settings → Environment Variables
#
# ⚠️  Ne jamais commiter le fichier .env.local avec de vraies valeurs.
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=
